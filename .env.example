# Gateway circuit breaker testing values
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=10

# Groq LLM provider. Keep the real key only in your untracked .env file.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Redis token-bucket rate limiting
TOKEN_BUCKET_CAPACITY=1000
REFILL_RATE=600
RATE_LIMIT_KEY_PREFIX=rate_limit
